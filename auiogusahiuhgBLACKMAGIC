if (-not ("Win32" -as [type])) {
Add-Type @"
using System;
using System.Runtime.InteropServices;

public class Win32 {
    [DllImport("user32.dll")]
    public static extern short GetAsyncKeyState(int vKey);

    [DllImport("user32.dll")]
    public static extern void mouse_event(int dwFlags, int dx, int dy, int dwData, int dwExtraInfo);

    [DllImport("winmm.dll")]
    public static extern uint timeBeginPeriod(uint uMilliseconds);

    public const int LEFTDOWN  = 0x02;
    public const int LEFTUP    = 0x04;
    public const int RIGHTDOWN = 0x08;
    public const int RIGHTUP   = 0x10;
}
"@
}

[Win32]::timeBeginPeriod(1)

$config = @(
    @(14, 16), @(12, 54), @(11, 15), @(13, 58), @(18, 12), @(15, 51),
    @(13, 17), @(11, 56), @(16, 11), @(14, 53), @(12, 19), @(15, 59),
    @(15, 13), @(12, 55), @(19, 14), @(11, 52), @(11, 16), @(13, 57),
    @(17, 12), @(14, 50), @(13, 15), @(12, 56), @(15, 11), @(16, 54),
    @(12, 18), @(11, 53), @(14, 13), @(13, 58), @(16, 16), @(12, 52),
    @(11, 14), @(14, 55), @(18, 13), @(13, 51), @(13, 16), @(15, 57),
    @(16, 12), @(11, 54), @(12, 17), @(14, 59), @(15, 14), @(12, 53),
    @(19, 11), @(13, 56), @(11, 15), @(16, 50), @(17, 13), @(12, 58),
    @(13, 18), @(14, 52), @(15, 12), @(11, 55), @(12, 16), @(13, 57),
    @(14, 14), @(15, 51), @(16, 15), @(12, 54), @(18, 11), @(14, 56)
)

$rand = [Random]::new()
$idx  = 0
$twoHeld = $false

function SpinWaitMs($ms) {
    $sw = [System.Diagnostics.Stopwatch]::StartNew()
    while ($sw.ElapsedMilliseconds -lt $ms) { }
}

Write-Host "ma ta" -ForegroundColor Gray
Write-Host "F12 ca sa iesi" -ForegroundColor Red

while ($true) {

    if ([Win32]::GetAsyncKeyState(0x7B) -lt 0) { break } # F12

    $twoDown = ([Win32]::GetAsyncKeyState(0x32) -lt 0)

    if ($twoDown -and -not $twoHeld) {
        SpinWaitMs 9
        [Win32]::mouse_event([Win32]::RIGHTDOWN, 0,0,0,0)
        [Win32]::mouse_event([Win32]::RIGHTUP,   0,0,0,0)
    }

    $twoHeld = $twoDown

    $doLeft  = ([Win32]::GetAsyncKeyState(0x06) -lt 0)
    $doRight = ([Win32]::GetAsyncKeyState(0x05) -lt 0)

    if ($doLeft -or $doRight) {

        $pair = $config[$idx % $config.Count]
        $idx++

        $downDelay = [Math]::Max(1, $pair[0] + $rand.Next(-0,2))
        $upDelay   = [Math]::Max(1, $pair[1] + $rand.Next(-0,2))

        if ($doLeft)  { [Win32]::mouse_event([Win32]::LEFTDOWN,  0,0,0,0) }
        if ($doRight) { [Win32]::mouse_event([Win32]::RIGHTDOWN, 0,0,0,0) }

        SpinWaitMs $downDelay

        if ($doLeft)  { [Win32]::mouse_event([Win32]::LEFTUP,  0,0,0,0) }
        if ($doRight) { [Win32]::mouse_event([Win32]::RIGHTUP, 0,0,0,0) }

        SpinWaitMs $upDelay
    }
}
